{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zazen-okayama",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"run_worker_first": ["/", "/admin", "/admin/*", "/api/*", "/media/*"]},
  "d1_databases": [{"binding":"DB", "database_name":"zazen-records", "database_id":"REPLACE_WITH_D1_DATABASE_ID", "migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET", "bucket_name":"zazen-photos"}],
  "vars": {
    "AUTH_PROVIDER":"cloudflare-access",
    "CF_ACCESS_TEAM_DOMAIN":"https://YOUR_TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD":"REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },
  "observability": {"enabled":true}
}
